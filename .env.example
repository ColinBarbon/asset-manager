# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# ─── Authentication ──────────────────────────────────────────────────────────
# Single shared password to access the app. Leave blank to disable auth entirely
# (anyone with network access can read/write). Set it for any shared deployment.
APP_PASSWORD=

# Secret used to sign session cookies. Set a long random string (e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# If unset, a random one is generated at boot and all sessions reset on restart.
SESSION_SECRET=

# How long a login stays valid, in hours. Defaults to 168 (7 days).
SESSION_TTL_HOURS=168

# ─── Jira repair-sync configuration ──────────────────────────────────────────
# Leave any of these blank/unset to keep the Jira integration disabled.

# Your Jira Cloud site, e.g. https://your-company.atlassian.net
JIRA_BASE_URL=

# The Atlassian account email the API token belongs to.
JIRA_EMAIL=

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# The key of your existing Repairs project, e.g. REP.
JIRA_PROJECT_KEY=

# Issue type to create. Defaults to "Task" if unset.
JIRA_ISSUE_TYPE=Task

# How often (ms) to poll open repair tickets for closure. Defaults to 300000 (5 min).
JIRA_POLL_INTERVAL_MS=300000
